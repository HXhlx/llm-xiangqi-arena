# Copy to .env and fill locally. Never commit real values.

# Redis (LangGraph checkpointer; Redis Stack / RediSearch required)
REDIS_URL=redis://:YOUR_PASSWORD@127.0.0.1:6379/0
# Optional overrides if REDIS_URL is unset:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Agent memory key prefix. Redis holds the current conversation window.
XIANGQI_REDIS_PREFIX=xiangqi:lg:
# XIANGQI_REDIS_TTL=0

# Public locale: en (default) or zh (Chinese player prompts / MCP briefs).
# An unknown value logs one warning per process and falls back to en
# (zh-TW is not zh).
# XIANGQI_LANG=en

# Referee secret. Operator credential only. Re-claiming an occupied seat
# requires this value (header X-Xiangqi-Referee-Secret) or that seat's
# current token. Both sides of the comparison are whitespace-stripped.
# An unset or empty secret never matches, so an empty header cannot
# rotate a seat. Leave unset to allow rotation only by the current seat
# token. Do not hand this value to player agents or paste it into player
# prompts. The MCP claim_seat parameter that forwards it is for the
# referee process; player briefs do not mention it.
# XIANGQI_REFEREE_SECRET=

# Shared LiteLLM (OpenAI-compatible) proxy for the "ai" seat.
# create_game type=ai reads these and plays as a server-driven LLM seat.
# Model: preset model, else LITELLM_MODEL. Without a preset, also send context_window.
# Leave commented until you have a real proxy. Uncommented placeholders
# (sk-xxxxxxxx) are rejected so create/restore/resume return 400 instead of
# calling the proxy with a template key.
# LITELLM_API_BASE=https://llm.example/v1
# LITELLM_API_KEY=sk-xxxxxxxx
# LITELLM_MODEL=example-model
# Optional comma-separated allowlist. Unset: unauthenticated create may
# name any model and spend LITELLM_API_KEY. Request api_base/api_key on
# type=ai are ignored; the seat always uses the env proxy above.
# LITELLM_ALLOWED_MODELS=example-model

# Per-ply cap on rejected make_move calls for an llm/ai seat (default 3).
# The Nth rejection interrupts the game with no winner (same as the
# text-only strike cap), not a forfeit. A legal move before the cap is
# played; the next ply starts at zero.
# XIANGQI_MAX_ILLEGAL_MOVES=3

# Per-ply cap on model/tool rounds for an llm/ai seat (default 32, clamped
# to 4–128). Exceeding it interrupts the game. Each round retries a failed
# call up to 3 times (about 4 requests per round in the worst case).
# XIANGQI_MAX_TOOL_ROUNDS=32

# Context compression (overrides config.yaml compress:)
# XIANGQI_CONTEXT_WINDOW=256000
# XIANGQI_COMPRESS_THRESHOLD_RATIO=0.9

# Match server URL seen by mcp_server.py
# XIANGQI_API_BASE=http://127.0.0.1:8000
