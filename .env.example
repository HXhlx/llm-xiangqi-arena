# Copy to .env and fill locally. Never commit real values.

# Redis (LangGraph checkpointer; Redis Stack / RediSearch required)
REDIS_URL=redis://:YOUR_PASSWORD@127.0.0.1:6379/0
# Optional overrides if REDIS_URL is unset:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Agent memory key prefix. Redis holds the current conversation window.
XIANGQI_REDIS_PREFIX=xiangqi:lg:
# XIANGQI_REDIS_TTL=0

# Public locale: en (default) or zh (Chinese player prompts / MCP briefs).
# XIANGQI_LANG=en

# Shared LiteLLM (or any OpenAI-compatible) proxy for the "AI player" type.
LITELLM_API_BASE=http://localhost:4000/v1
LITELLM_API_KEY=sk-xxxxxxxx

# Context compression (overrides config.yaml compress:)
# XIANGQI_CONTEXT_WINDOW=256000
# XIANGQI_COMPRESS_THRESHOLD_RATIO=0.9

# Match server URL seen by mcp_server.py
# XIANGQI_API_BASE=http://127.0.0.1:8000
